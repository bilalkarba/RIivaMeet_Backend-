{
  "name": "coachini-api",
  "version": "1.0.0",
  "private": true,
  "description": "Sports coach discovery and booking platform API (Express + TypeScript + Prisma + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,prisma,scripts}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "prisma migrate reset --force",
    "migrate:dev:local": "tsx scripts/with-embedded-db.ts -- prisma migrate dev",
    "seed": "prisma db seed",
    "seed:local": "tsx scripts/with-embedded-db.ts -- prisma db seed",
    "db:start": "tsx scripts/dev-db.ts start",
    "db:status": "tsx scripts/dev-db.ts status",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@unity-china/codely-cli": "^1.0.0-rc.60",
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.4.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
