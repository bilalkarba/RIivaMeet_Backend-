// ---------------------------------------------------------------------------
// Coachini API - Prisma schema
//
// Conventions:
//  - Tables and columns are mapped to snake_case so raw SQL (used for the
//    Haversine distance search) stays readable.
//  - All timestamps are `timestamptz(3)` to avoid timezone ambiguity.
//  - Money is `decimal(10, 2)` - never float - so booking prices stay exact.
//  - Coach ratings are NOT stored: they are always derived from `reviews`
//    (single source of truth) and included in read models on the fly.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  // Explicit ESM output so the generated client compiles with `tsc` (NodeNext)
  // and runs unchanged under Node, tsx and Vitest.
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (Prisma ORM 7 requirement).
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  BOOKING_REQUEST
}

/// Audio or video. Media itself is peer-to-peer (WebRTC); this only records intent.
enum CallType {
  AUDIO
  VIDEO
}

/// Lifecycle of a 1:1 call.
///  RINGING   - created, callee has not answered yet (answeredAt/endedAt null)
///  ACCEPTED  - callee answered, media is flowing (answeredAt set, endedAt null)
///  REJECTED  - callee declined (endedAt set)
///  MISSED    - nobody answered in time, or the callee was unreachable (endedAt set)
///  CANCELLED - caller hung up before the callee answered (endedAt set)
///  ENDED     - a connected call finished normally (answeredAt and endedAt set)
enum CallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  CANCELLED
  ENDED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

/// What a report points at. `targetId` references the relevant row (a user, a post, a
/// message); `targetUserId` is filled in for USER reports so moderation can query it.
enum ReportTargetType {
  USER
  POST
  MESSAGE
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

/// Coach verification lifecycle (see `src/services/verification.service.ts`).
///  DRAFT      - documents can still be uploaded/removed; never visible to admins as work
///  PENDING    - submitted and awaiting review
///  IN_REVIEW  - an administrator is actively reviewing the application
///  NEEDS_INFO - the administrator asked for more/corrected documents
///  APPROVED   - verified; the coach may become publicly discoverable (still subject to
///               the existing profile publication rules: coordinates + at least one sport)
///  REJECTED   - refused; the coach may correct and resubmit
enum VerificationStatus {
  DRAFT
  PENDING
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
}

/// Machine analysis state. Deliberately separate from `VerificationStatus` so an AI
/// result can NEVER be confused with an official (human) decision. Research-and-verify
/// concern: only an ADMIN can move a verification to APPROVED/REJECTED.
enum AiAnalysisStatus {
  NOT_STARTED
  PENDING
  COMPLETED
  FAILED
  MANUAL_REVIEW
}

/// Kind of professional document. Extend this enum (plus the migration) to require
/// identity documents later; `VERIFICATION_REQUIRED_DOCUMENT_TYPES` decides what is
/// mandatory at submission time.
enum VerificationDocumentType {
  DIPLOMA
  CERTIFICATION
  OTHER
}

/// Append-only audit trail of everything that happened to an application.
enum VerificationEventType {
  APPLICATION_STARTED
  DOCUMENT_UPLOADED
  DOCUMENT_REMOVED
  SUBMITTED
  RESUBMITTED
  MARKED_IN_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED
  AI_ANALYSIS_STARTED
  AI_ANALYSIS_COMPLETED
  AI_ANALYSIS_FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Stored lower-cased + trimmed. Unique index enforces one account per address.
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         Role     @default(CLIENT)
  /// Public pseudonym shown instead of `name` when set.
  displayName  String?  @map("display_name")
  /// Public avatar URL (object storage); never a path on the application server.
  avatarUrl    String?  @map("avatar_url")
  /// Free-form profile bio. Distinct from the coach bio on `coach_profiles`.
  bio          String?  @db.Text
  city         String?
  country      String?
  /// Athlete/self-declared level. Coaches keep their own level on `coach_profiles`.
  level        ExperienceLevel?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  coachProfile CoachProfile?
  bookings     Booking[]     @relation("ClientBookings")
  reviews      Review[]
  sports       UserSport[]

  verificationsReviewed CoachVerification[]      @relation("VerificationReviewer")
  verificationEvents    CoachVerificationEvent[] @relation("VerificationEventActor")

  blocksInitiated Block[]  @relation("BlockerBlocks")
  blocksReceived  Block[]  @relation("BlockedBlocks")
  reportsFiled    Report[] @relation("ReportReporter")
  reportsAgainst  Report[] @relation("ReportTargetUser")
  reportsReviewed Report[] @relation("ReportReviewer")

  conversations ConversationParticipant[]
  messagesSent  Message[]                 @relation("MessageSender")
  notifications Notification[]            @relation("NotificationRecipient")

  moderationFlagsRaised   MessageModerationFlag[] @relation("ModerationFlagSender")
  moderationFlagsReviewed MessageModerationFlag[] @relation("ModerationFlagReviewer")

  callsInitiated Call[] @relation("CallCaller")
  callsReceived  Call[] @relation("CallCallee")
  callsEnded     Call[] @relation("CallEnder")

  @@index([role])
  @@index([city, country])
  @@map("users")
}

model CoachProfile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @map("user_id") @db.Uuid
  bio             String          @db.Text
  /// Free-form certifications / qualifications (e.g. "UEFA B Licence", "Lifeguard").
  certifications  String[]        @default([])
  hourlyPrice     Decimal         @map("hourly_price") @db.Decimal(10, 2)
  experienceLevel ExperienceLevel @map("experience_level")
  city            String
  neighborhood    String
  address         String?
  /// Nullable so a profile can be drafted; coordinates are REQUIRED to publish
  /// (enforced in the service layer) because distance search depends on them.
  latitude        Float?
  longitude       Float?
  isPublished     Boolean         @default(false) @map("is_published")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sports       CoachSport[]
  availability Availability[]
  bookings     Booking[]
  reviews      Review[]

  /// One verification application per coach profile. The row is created on the first
  /// document upload (status DRAFT) and then updated in place on every submission, so
  /// there is a single source of truth for "is this coach verified?".
  verification CoachVerification?

  @@index([isPublished, hourlyPrice])
  @@index([city, neighborhood])
  @@index([latitude, longitude])
  @@map("coach_profiles")
}

model Sport {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coaches CoachSport[]
  athletes UserSport[]

  @@map("sports")
}

/// A discipline a user (usually an athlete) practices, with an optional per-sport level.
/// Coaches keep their taught sports on `coach_sports`; this table powers athlete
/// profiles and the compatible-profile matching endpoint.
model UserSport {
  userId    String           @map("user_id") @db.Uuid
  sportId   String           @map("sport_id") @db.Uuid
  level     ExperienceLevel?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  // Composite primary key: a user cannot practise the same discipline twice.
  @@id([userId, sportId])
  @@index([sportId])
  @@map("user_sports")
}

model CoachSport {
  coachProfileId String   @map("coach_profile_id") @db.Uuid
  sportId        String   @map("sport_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  sport        Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)

  // Composite primary key: a coach cannot offer the same sport twice.
  @@id([coachProfileId, sportId])
  @@index([sportId])
  // Secondary access path of the coach search query (sport -> coach lookup).
  // Declared here so `prisma migrate` manages it and never drops it as drift.
  @@index([sportId, coachProfileId])
  @@map("coach_sports")
}

model Availability {
  id             String   @id @default(uuid()) @db.Uuid
  coachProfileId String   @map("coach_profile_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz(3)
  endAt          DateTime @map("end_at") @db.Timestamptz(3)
  isAvailable    Boolean  @default(true) @map("is_available")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@index([coachProfileId, startAt])
  @@index([coachProfileId, isAvailable, startAt, endAt])
  @@map("availabilities")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  coachProfileId String        @map("coach_profile_id") @db.Uuid
  startAt        DateTime      @map("start_at") @db.Timestamptz(3)
  endAt          DateTime      @map("end_at") @db.Timestamptz(3)
  /// Snapshot of the coach's hourly price * session length at request time.
  priceAtBooking Decimal       @map("price_at_booking") @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  client       User         @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  review       Review?
  notification Notification?
  conversation Conversation?

  @@index([clientId, status])
  @@index([coachProfileId, status])
  @@index([coachProfileId, startAt, endAt])
  @@map("bookings")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  bookingId   String           @unique @map("booking_id") @db.Uuid
  type        NotificationType @default(BOOKING_REQUEST)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model Review {
  id             String   @id @default(uuid()) @db.Uuid
  /// Unique => one review per booking, enforced at the database level.
  bookingId      String   @unique @map("booking_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  coachProfileId String   @map("coach_profile_id") @db.Uuid
  rating         Int
  comment        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client       User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@index([coachProfileId, createdAt])
  @@map("reviews")
}

/// A directional block. The blocked user disappears from the blocker's discovery
/// results, and (once chat exists) neither party can message the other.
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("BlockerBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBlocks", fields: [blockedId], references: [id], onDelete: Cascade)

  // One block per direction; unblocking deletes the row.
  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// A moderation report against a user, post or message.
model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  /// Id of the reported entity (user id, post id or message id).
  targetId       String           @map("target_id") @db.Uuid
  /// Set for USER reports; null for other targets until those models exist.
  targetUserId   String?          @map("target_user_id") @db.Uuid
  reason         ReportReason
  description    String?          @db.Text
  status         ReportStatus     @default(PENDING)
  reviewedById   String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  resolutionNote String?          @map("resolution_note") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User? @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId])
  @@index([reporterId, createdAt])
  @@map("reports")
}

/// A private 1:1 conversation. Group chat is intentionally out of scope; the model
/// keeps a participants table so adding it later is a data change, not a rewrite.
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String?   @unique @map("booking_id") @db.Uuid
  /// Bumped on every message so inboxes can be ordered cheaply.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants   ConversationParticipant[]
  messages       Message[]
  calls          Call[]
  moderationFlags MessageModerationFlag[]
  booking        Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  /// Last time this participant opened the conversation; powers unread counts.
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  revision       Int      @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  moderationFlags MessageModerationFlag[]
  attachment     ChatAttachment?

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ChatAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @unique @map("message_id") @db.Uuid
  clientUploadId String   @unique @map("client_upload_id") @db.Uuid
  storageKey     String   @unique @map("storage_key")
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  checksum       String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("chat_attachments")
}

/// A message held for administrator review because it contained off-platform contact
/// details while `MESSAGE_MODERATION_POLICY=flag`.
///
/// The message itself is still persisted and delivered (flag is not a block); this row is
/// the audit/moderation trail. `matches` contains detector kinds/labels only - never the
/// matched phone number or address. Only administrators can read this table.
model MessageModerationFlag {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  /// Policy active when the message was flagged (`flag`). Stored for auditability.
  policy         String
  /// Structured detector result: [{ kind, label }]. Never the raw matched value.
  matches        Json
  reviewedById   String?  @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote     String?  @map("review_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ModerationFlagSender", fields: [senderId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ModerationFlagReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([reviewedAt, createdAt])
  @@index([senderId, createdAt])
  @@map("message_moderation_flags")
}

/// Call history for a 1:1 audio/video call.
///
/// Calls are scoped to a booking conversation, so only a client and their coach can
/// call each other. Nothing about the media is stored (no recording, no SDP, no ICE
/// candidates): this table only records who called whom, when, and how it ended, which
/// is what the UI needs for a call log and what the server needs to prevent a second
/// concurrent call. Live call coordination is in-memory (`call.service`); this is the
/// durable record.
model Call {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @map("conversation_id") @db.Uuid
  callerId       String     @map("caller_id") @db.Uuid
  calleeId       String     @map("callee_id") @db.Uuid
  type           CallType
  status         CallStatus @default(RINGING)
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz(3)
  /// Set when the callee accepts. Present iff status is ACCEPTED or ENDED.
  answeredAt     DateTime?  @map("answered_at") @db.Timestamptz(3)
  /// Set when the call reaches a terminal state. Absent while RINGING or ACCEPTED.
  endedAt        DateTime?  @map("ended_at") @db.Timestamptz(3)
  /// Who hung up (or declined/timed out), for the call log.
  endedById      String?    @map("ended_by_id") @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User         @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  endedBy      User?        @relation("CallEnder", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([conversationId, startedAt])
  @@index([calleeId, status])
  @@index([callerId, status])
  @@map("calls")
}

/// Coach verification application.
///
/// This is the ONLY source of truth for coach approval: discovery, public coach detail
/// and booking creation all require `status = APPROVED`. It is intentionally separate
/// from `CoachProfile.isPublished` - publishing is a profile-completeness concern
/// (coordinates + sports), verification is a trust concern.
///
/// `ai_*` columns hold the machine analysis. They are advisory only and never write to
/// `status`; a provider cannot approve an account, and model output is treated as
/// untrusted input (validated with Zod before it is stored).
model CoachVerification {
  id             String             @id @default(uuid()) @db.Uuid
  /// One application per coach. Cascade on profile deletion so no orphan rows remain.
  coachProfileId String             @unique @map("coach_profile_id") @db.Uuid
  status         VerificationStatus @default(DRAFT)
  /// Set the first time the application is submitted.
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz(3)
  /// Updated on every (re)submission, so admins can sort by newest activity.
  lastSubmittedAt DateTime?         @map("last_submitted_at") @db.Timestamptz(3)

  aiStatus           AiAnalysisStatus @default(NOT_STARTED) @map("ai_status")
  /// Provider/model recorded for auditability; provider errors are never exposed to clients.
  aiProvider         String?          @map("ai_provider")
  aiModel            String?          @map("ai_model")
  /// Validated, structured extraction result (untrusted input, sanitized on write).
  aiResult           Json?            @map("ai_result")
  /// Neutral warning flags, e.g. LOW_READABILITY, NAME_MISMATCH, AUTHENTICITY_UNVERIFIED.
  aiFlags            String[]         @default([]) @map("ai_flags")
  aiSummary          String?          @map("ai_summary") @db.Text
  /// Stable, safe error code (TIMEOUT, PROVIDER_ERROR, INVALID_RESPONSE, ...), never a stack trace.
  aiErrorCode        String?          @map("ai_error_code")
  /// Number of provider calls made for the current submission cycle (cost guard).
  aiAttempts         Int              @default(0) @map("ai_attempts")
  /// Hash of the document set that was analyzed, so an unchanged set is not re-sent.
  aiAnalyzedInputHash String?         @map("ai_analyzed_input_hash")
  aiAnalyzedAt       DateTime?        @map("ai_analyzed_at") @db.Timestamptz(3)

  /// Set only for APPROVED/REJECTED (enforced by a CHECK constraint too).
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)
  /// Admin decision note / feedback shown to the coach (e.g. the rejection reason).
  reviewNote   String?   @map("review_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  documents CoachVerificationDocument[]
  events    CoachVerificationEvent[]

  @@index([status, submittedAt])
  @@index([aiStatus])
  @@index([reviewedById])
  @@map("coach_verifications")
}

/// An uploaded professional document.
///
/// The bytes live in private object storage; PostgreSQL only keeps the safe metadata and
/// the storage key. Keys are always server-generated (`verifications/<verificationId>/…`)
/// so a client filename can never influence the path (no traversal, no collisions).
model CoachVerificationDocument {
  id             String                  @id @default(uuid()) @db.Uuid
  verificationId String                  @map("verification_id") @db.Uuid
  type           VerificationDocumentType
  storageProvider String                 @map("storage_provider")
  storageBucket  String?                 @map("storage_bucket")
  /// Private object key. Unique so two rows can never point at the same object.
  storageKey     String                  @unique @map("storage_key")
  /// Sanitized display name only; NEVER used to build the storage key.
  originalFileName String?               @map("original_file_name")
  contentType    String                  @map("content_type")
  sizeBytes      Int?                    @map("size_bytes")
  checksumSha256 String?                 @map("checksum_sha256")
  /// True once the upload was confirmed to exist in storage.
  isCurrent      Boolean                 @default(false) @map("is_current")
  confirmedAt    DateTime?               @map("confirmed_at") @db.Timestamptz(3)
  uploadedAt     DateTime                @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  verification CoachVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, isCurrent])
  @@index([verificationId, type])
  @@map("coach_verification_documents")
}

/// Append-only audit history (who changed what, when, and why).
model CoachVerificationEvent {
  id             String                @id @default(uuid()) @db.Uuid
  verificationId String                @map("verification_id") @db.Uuid
  type           VerificationEventType
  fromStatus     VerificationStatus?   @map("from_status")
  toStatus       VerificationStatus?   @map("to_status")
  /// Null for system/AI events; SetNull keeps history when an admin account is deleted.
  actorUserId    String?               @map("actor_user_id") @db.Uuid
  actorRole      Role?                 @map("actor_role")
  note           String?               @db.Text
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  verification CoachVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  actor        User?             @relation("VerificationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([verificationId, createdAt])
  @@map("coach_verification_events")
}
