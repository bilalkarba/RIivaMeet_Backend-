# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Number of reverse-proxy hops in front of the app (Northflank load balancer = 1).
# Required for correct client IPs in rate limiting and logs. Use 1 in production.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database (PostgreSQL) - REQUIRED
# ---------------------------------------------------------------------------
# Example: postgresql://user:password@localhost:5432/coachini?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/coachini?schema=public


# Optional. Only used by `prisma migrate dev` to create the shadow database.
# If unset, Prisma creates and drops the shadow database automatically.
SHADOW_DATABASE_URL=

# Enable TLS for the database connection: false | true | no-verify
# Managed providers (Neon, Supabase, RDS, Northflank Postgres) usually need "true".
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Authentication - REQUIRED
# ---------------------------------------------------------------------------
# Must be at least 32 characters long. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
# Access token lifetime (zeit/ms format: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h
JWT_ISSUER=coachini-api

# bcrypt cost factor. 10-12 is a good production range.
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# HTTP / security
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Never use "*" in production.
FRONTEND_URL=http://localhost:4200

# Rate limiting (milliseconds / request counts)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Per-account budget for sending chat messages inside the window above.
CHAT_RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# Message moderation (off-platform contact sharing)
# ---------------------------------------------------------------------------
# Every REST and Socket.IO message is scanned server-side before it is persisted or
# broadcast. Detection covers phone numbers (incl. Arabic-Indic and obfuscated forms),
# email addresses, WhatsApp/Facebook/Instagram/Telegram links, other social profile URLs
# and social handles introduced by a network name.
MESSAGE_MODERATION_ENABLED=true
# warn  = deliver the message and warn the sender (least disruptive)
# block = reject the message before it is persisted or broadcast (server default)
# flag  = deliver the message and add it to the ADMIN review queue
MESSAGE_MODERATION_POLICY=block

# ---------------------------------------------------------------------------
# Object storage (avatar / post media + private chat attachments)
# ---------------------------------------------------------------------------
# none  = uploads disabled; media endpoints answer 503 with the required variables
# s3    = any S3-compatible provider (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, B2)
# local = development/test only; files are written under STORAGE_LOCAL_DIR (refused in production)
# Local development uses disk storage. Set this to "s3" and configure credentials for deployment.
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3:
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# Optional custom endpoint for S3-compatible providers (leave empty for AWS S3)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL used to build object URLs (CDN domain or bucket URL), e.g. https://cdn.rivameet.app
STORAGE_PUBLIC_BASE_URL=
# true for MinIO and other path-style endpoints
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=5242880
# Chat attachments (JPEG/PNG/WebP/PDF) use this limit and the private document bucket below.
# Only used by STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.tmp/uploads

# ---------------------------------------------------------------------------
# Coach verification (private documents)
# ---------------------------------------------------------------------------
# Verification documents (diplomas/certificates) reuse the STORAGE_* provider above but are
# never given a public URL: they live under the `verifications/` key prefix and are only
# readable through the authenticated admin endpoint (the API streams the bytes).
# IMPORTANT: the bucket (or at least the `verifications/*` prefix) must NOT be publicly
# readable. This dedicated private bucket is required for production chat attachments;
# never use a public-media bucket for it.
STORAGE_DOCUMENT_BUCKET=
# Maximum size of one verification document (default 10 MB).
STORAGE_DOCUMENT_MAX_UPLOAD_BYTES=10485760
# Document types required before a coach can submit: DIPLOMA, CERTIFICATION, OTHER.
# Empty = any single document. Identity documents are intentionally NOT required.
VERIFICATION_REQUIRED_DOCUMENT_TYPES=DIPLOMA,CERTIFICATION

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Audio / video calls (WebRTC signalling over Socket.IO)
# ---------------------------------------------------------------------------
# How long the callee has to answer before the call is marked MISSED (5000-120000 ms).
CALL_RING_TIMEOUT_MS=45000
# Grace period after the last signalling socket drops before the server ends a call.
# Covers tab visibility changes, OS sleep and short Wi-Fi handovers. 0 = end immediately.
CALL_DISCONNECT_GRACE_MS=15000
# Hard ceiling for a connected call, so a crashed client cannot hold a session forever.
CALL_MAX_DURATION_MINUTES=240
# Per-account call-attempt and signalling budgets.
CALL_INVITE_RATE_LIMIT_MAX=20
CALL_SIGNAL_RATE_LIMIT_MAX=300
CALL_SIGNAL_RATE_LIMIT_WINDOW_MS=60000
# Comma-separated STUN URLs. A public server is enough for most networks; set to empty to disable.
STUN_URLS=stun:stun.l.google.com:19302
# TURN relays media when both peers are behind strict NAT. Required for reliable calls
# in production (Cloudflare Realtime TURN, Metered, coturn, Twilio, ...).
# Comma-separated, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
# Option A (preferred): TURN REST API shared secret (coturn static-auth-secret, Metered).
# The API mints a short-lived username/credential per request; this secret never leaves
# the server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TURN_SHARED_SECRET=
# Option B: a static TURN username/credential for providers without the shared-secret
# scheme (Twilio, Cloudflare). Provided only via env - never committed to source.
TURN_USERNAME=
TURN_CREDENTIAL=
# Lifetime of the minted TURN credentials, in seconds.
TURN_CREDENTIAL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
